# Street map style for the "Set on map" pin picker (optional).
# Unset = OpenFreeMap (https://tiles.openfreemap.org/styles/liberty): free, no key, no account.
# Any MapLibre style URL works, e.g. MapTiler's free tier if OpenFreeMap is ever down:
#   https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# Baked in at BUILD time, so changing it needs a rebuild.
# EXPO_PUBLIC_MAP_STYLE_URL=

# Password reset — Supabase Redirect URLs must include this (matches the "scheme": rapid in app.config.ts).
# Override only for Expo Go / dev if needed (paste the URL from Linking.createURL('/reset-password')).
# EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=rapid://reset-password
