# Backend API URL — used for /api/assessments/sync and /api/ai/predict/*
# Use your machine's LAN IP (not localhost) so Expo Go on a real phone can reach it.
# Find it with `ipconfig` (Windows) or `ifconfig` (macOS/Linux).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Supabase — find these in Supabase Dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
