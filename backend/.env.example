# Supabase — from Supabase Dashboard > Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL — Supabase Dashboard > Settings > Database > Connection string
# Prefer the "Direct connection" URI for local dev (host db.<ref>.supabase.co, user postgres, port 5432).
# Pooler URIs must match Supabase's mode: transaction pooler uses port 6543 and user postgres.<ref>.
# Wrong pooler user/port causes: FATAL: Tenant or user not found
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# CORS — comma-separated allowed origins (Vite dev + Expo dev defaults)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Gemini API key — https://aistudio.google.com/apikey
# Leave blank to use the built-in template fallback action-plan generator.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# NOT USED BY THE API ANY MORE
#
# Inference runs on the phone against the models bundled in mobile/assets/models/,
# and the API stores that verdict verbatim. MODEL_DIR, SRTM_DIR, GEO_BUNDLE_PATH,
# FUSION_IMAGE_WEIGHT, FUSION_TABULAR_WEIGHT and ML_ARTIFACTS_URL no longer affect
# the running service — do not set them on Railway or Cloud Run.
#
# They still apply to the offline tooling in ml/ and to
# backend/app/services/ml_fusion_engine.py, which stays as the reference
# implementation that ml/scripts/parity_test_mobile_models.py checks the device
# against. Fusion weights live in TWO places and must be changed together:
#   backend/app/services/ml_fusion_engine.py  (IMAGE_WEIGHT / TABULAR_WEIGHT)
#   mobile/services/ml/constants.ts           (hardcoded — no env override)
# ---------------------------------------------------------------------------
