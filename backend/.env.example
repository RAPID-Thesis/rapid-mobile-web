# Supabase — from Supabase Dashboard > Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL — Supabase Dashboard > Settings > Database > Connection string
# Prefer the "Direct connection" URI for local dev (host db.<ref>.supabase.co, user postgres, port 5432).
# Pooler URIs must match Supabase's mode: transaction pooler uses port 6543 and user postgres.<ref>.
# Wrong pooler user/port causes: FATAL: Tenant or user not found
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# CORS — comma-separated allowed origins (Vite dev + Expo dev defaults)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Gemini API key — https://aistudio.google.com/apikey
# Leave blank to use the built-in template fallback action-plan generator.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional — paths to trained model artifacts and SRTM elevation tile.
# Defaults are resolved relative to backend/ (i.e. ../ml/artifacts and ../ml/data/gis/srtm).
# MODEL_DIR=../ml/artifacts
# SRTM_DIR=../ml/data/gis/srtm

# Optional — late fusion weights (must sum to 1.0; defaults 0.45 / 0.55).
# FUSION_IMAGE_WEIGHT=0.45
# FUSION_TABULAR_WEIGHT=0.55
